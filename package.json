{
  "name": "dsh-antigravity-router",
  "version": "0.1.0",
  "description": "Router bundle: every session delegates all work to the Antigravity CLI subagent and keeps no other tool.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "antigravity",
    "agy",
    "subagent",
    "router"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
